@using CoordinacionOrientadores.Models
@{
    ViewData["Title"] = "Inicio";
    var proximas = ViewBag.ProximasAsignaciones as List<Asignacion>;
}

<h1>Programa de Orientación — Coordinación</h1>
<p class="text-muted">Sistema propio para repartir la carga de los orientadores, gestionar ausencias y reemplazar la calendarización manual en Word — sin depender de Teams ni de una licencia de Azure.</p>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center p-3 bg-light">
            <h2>@ViewBag.TotalOrientadores</h2>
            <small>Orientadores activos</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 bg-light">
            <h2>@ViewBag.ProcesosHoy</h2>
            <small>Procesos programados hoy</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 @(((int)ViewBag.Conflictos) > 0 ? "bg-danger text-white" : "bg-light")">
            <h2>@ViewBag.Conflictos</h2>
            <small>⚠ En conflicto (necesitan sustituto)</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 bg-light">
            <h2>@ViewBag.AusentesHoy</h2>
            <small>Ausentes hoy</small>
        </div>
    </div>
</div>

@if (((int)ViewBag.Conflictos) > 0)
{
    <div class="alert alert-danger">
        Hay asignaciones en conflicto por ausencias registradas.
        <a asp-controller="Asignaciones" asp-action="Index">Ir a resolverlas →</a>
    </div>
}

<h4>Próximos procesos</h4>
<table class="table table-sm">
    <thead><tr><th>Fecha</th><th>Hora</th><th>Proceso</th><th>Orientador</th></tr></thead>
    <tbody>
    @foreach (var a in proximas!)
    {
        <tr>
            <td>@a.Fecha.ToString("dd/MM/yyyy")</td>
            <td>@a.HoraInicio.ToString(@"hh\:mm")</td>
            <td>@a.ProcesoNombre</td>
            <td>@a.OrientadorNombre</td>
        </tr>
    }
    </tbody>
</table>

<div class="mt-3">
    <a class="btn btn-primary" asp-controller="Asignaciones" asp-action="Nueva">+ Programar proceso</a>
    <a class="btn btn-outline-secondary" asp-controller="Ausencias" asp-action="Create">+ Registrar ausencia</a>
</div>
