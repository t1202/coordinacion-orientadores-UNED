@model List<CoordinacionOrientadores.Models.Proceso>
@{
    ViewData["Title"] = "Procesos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Catálogo de procesos</h1>
    <a class="btn btn-primary" asp-action="Create">+ Nuevo proceso</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Duración</th>
            <th>Modalidad</th>
            <th>Enlace</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Nombre</td>
            <td>@p.Descripcion</td>
            <td>@p.DuracionMinutos min</td>
            <td>@p.Modalidad</td>
            <td>@(p.RequiereEnlace ? "Sí" : "No")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este proceso?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
