@model CoordinacionOrientadores.Models.Proceso
@{
    ViewData["Title"] = "Editar proceso";
}
<h1>Editar proceso</h1>
<form asp-action="Edit" method="post" class="row g-3" style="max-width:700px">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-12">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>
    <div class="col-md-4">
        <label asp-for="DuracionMinutos" class="form-label"></label>
        <input asp-for="DuracionMinutos" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Modalidad" class="form-label"></label>
        <select asp-for="Modalidad" class="form-select" asp-items="Html.GetEnumSelectList<CoordinacionOrientadores.Models.Modalidad>()"></select>
    </div>
    <div class="col-md-4 form-check mt-4">
        <input asp-for="RequiereEnlace" class="form-check-input" />
        <label asp-for="RequiereEnlace" class="form-check-label"></label>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>
