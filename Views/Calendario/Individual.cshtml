@model List<CoordinacionOrientadores.Models.Asignacion>
@using CoordinacionOrientadores.Models
@{
    ViewData["Title"] = "Mi calendario";
    var orientadores = ViewBag.Orientadores as List<Orientador>;
    var inicioSemana = (DateTime)ViewBag.InicioSemana;
    var ausencias = ViewBag.Ausencias as List<Ausencia>;
    var dias = Enumerable.Range(0, 7).Select(i => inicioSemana.AddDays(i)).ToList();
}

<h1>Mi calendario</h1>
<p class="text-muted">Vista individual: cada orientador ve solo lo suyo, sin saturarse con lo de los demás.</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="orientadorId" class="form-select" onchange="this.form.submit()">
            @foreach (var o in orientadores!)
            {
                <option value="@o.Id" selected="@(ViewBag.OrientadorSeleccionado?.ToString() == o.Id.ToString())">@o.Nombre</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <a class="btn btn-outline-secondary" asp-action="Individual" asp-route-orientadorId="@ViewBag.OrientadorSeleccionado" asp-route-semana="@inicioSemana.AddDays(-7).ToString("yyyy-MM-dd")">← Semana anterior</a>
    </div>
    <div class="col-auto">
        <a class="btn btn-outline-secondary" asp-action="Individual" asp-route-orientadorId="@ViewBag.OrientadorSeleccionado" asp-route-semana="@inicioSemana.AddDays(7).ToString("yyyy-MM-dd")">Semana siguiente →</a>
    </div>
</form>

<div class="row">
@foreach (var dia in dias)
{
    var items = Model.Where(a => a.Fecha.Date == dia.Date).OrderBy(a => a.HoraInicio).ToList();
    var ausenteEseDia = ausencias!.Any(a => dia.Date >= a.FechaInicio.Date && dia.Date <= a.FechaFin.Date);
    <div class="col border rounded p-2 me-1 mb-2" style="min-height:160px">
        <strong>@dia.ToString("ddd dd/MM")</strong>
        @if (ausenteEseDia)
        {
            <div class="badge bg-secondary mt-1 mb-1">Ausente</div>
        }
        @foreach (var a in items)
        {
            var clase = a.Estado == EstadoAsignacion.EnConflicto ? "bg-danger" : "bg-primary";
            <div class="small p-1 mt-1 rounded text-white @clase">
                @a.HoraInicio.ToString(@"hh\:mm") @a.ProcesoNombre
                @if (!string.IsNullOrEmpty(a.EnlaceReunion))
                {
                    <br /><a class="text-white" href="@a.EnlaceReunion" target="_blank">enlace</a>
                }
            </div>
        }
    </div>
}
</div>
